# 统一换行符与文本处理，避免跨平台差异
# 让仓库内所有文本文件始终以 LF 存储（Windows 检出时也不转换）
* text=auto eol=lf

# 明确二进制文件，不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.so binary

# 文档类明确按文本处理
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
